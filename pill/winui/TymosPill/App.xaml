<Application
    x:Class="TymosPill.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TymosPill">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <SolidColorBrush x:Key="PillGlass" Color="#E61C1610"/>
      <SolidColorBrush x:Key="PillBreakGlass" Color="#E6181C22"/>
      <SolidColorBrush x:Key="PillHairline" Color="#29F3EADC"/>
      <SolidColorBrush x:Key="PillBreakHairline" Color="#29C8E4EC"/>
      <SolidColorBrush x:Key="PillTime" Color="#F3EADC"/>
      <SolidColorBrush x:Key="PillBreakTime" Color="#E8F1F4"/>
      <SolidColorBrush x:Key="PillTitle" Color="#9EF3EADC"/>
      <SolidColorBrush x:Key="PillBreakTitle" Color="#9ED2E6EC"/>
      <SolidColorBrush x:Key="PillTrack" Color="#24F3EADC"/>
      <SolidColorBrush x:Key="PillBreakTrack" Color="#24E8F1F4"/>
      <SolidColorBrush x:Key="PillRing" Color="#C9A87A"/>
      <SolidColorBrush x:Key="PillBreakRing" Color="#7EAFC0"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
