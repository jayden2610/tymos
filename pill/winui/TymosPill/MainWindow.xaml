<Window
    x:Class="TymosPill.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tymos">

  <Grid x:Name="Root" Background="Transparent">
    <Border
        x:Name="PillChrome"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="14,10,18,10"
        CornerRadius="999"
        Background="{StaticResource PillBg}"
        BorderBrush="{StaticResource PillBorder}"
        BorderThickness="1">

      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Ellipse
            x:Name="StatusDot"
            Width="8"
            Height="8"
            Fill="{StaticResource PillAccent}"
            VerticalAlignment="Center" />

        <TextBlock
            x:Name="TimeText"
            Text="24:32"
            FontFamily="Consolas"
            FontSize="18"
            Foreground="{StaticResource PillText}"
            VerticalAlignment="Center" />

        <Rectangle
            Width="1"
            Height="18"
            Fill="{StaticResource PillDivider}"
            VerticalAlignment="Center" />

        <TextBlock
            x:Name="TitleText"
            Text="Ship floating pill"
            FontFamily="Segoe UI"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{StaticResource PillText2}"
            MaxWidth="220"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap"
            VerticalAlignment="Center" />

        <TextBlock
            x:Name="PhaseText"
            Text="FOCUS"
            FontFamily="Consolas"
            FontSize="9"
            Foreground="{StaticResource PillMuted}"
            VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
