<Window
    x:Class="TymosPill.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tymos">

  <Grid x:Name="Root" Background="{StaticResource PillGlass}">
    <Border
        x:Name="PillChrome"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="8,7,16,7"
        CornerRadius="999"
        Background="{StaticResource PillGlass}"
        BorderBrush="{StaticResource PillHairline}"
        BorderThickness="1">

      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Grid Width="28" Height="28" VerticalAlignment="Center">
          <Ellipse
              x:Name="RingTrack"
              Width="24"
              Height="24"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Fill="Transparent"
              Stroke="{StaticResource PillTrack}"
              StrokeThickness="2.25" />
          <Path
              x:Name="RingFill"
              Width="28"
              Height="28"
              Stretch="None"
              Fill="Transparent"
              Stroke="{StaticResource PillRing}"
              StrokeThickness="2.25"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" />
          <Ellipse
              x:Name="CoreDot"
              Width="7"
              Height="7"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Fill="{StaticResource PillRing}" />
        </Grid>

        <TextBlock
            x:Name="TimeText"
            Text="24:32"
            FontFamily="Consolas"
            FontSize="17"
            Foreground="{StaticResource PillTime}"
            VerticalAlignment="Center" />

        <TextBlock
            x:Name="TitleText"
            Text="Ship floating pill"
            FontFamily="Segoe UI"
            FontSize="13"
            FontWeight="SemiBold"
            Foreground="{StaticResource PillTitle}"
            MaxWidth="200"
            TextTrimming="CharacterEllipsis"
            TextWrapping="NoWrap"
            VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
